# Normalize line endings to LF on checkin
* text=auto eol=lf

# Explicit text files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Windows scripts keep CRLF
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# Large binary assets via Git LFS
*.psd   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
