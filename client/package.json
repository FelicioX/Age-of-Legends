{
  "name": "@aol/client",
  "version": "0.1.0",
  "private": true,
  "description": "Player client for Age of Legends: React UI and PixiJS world rendering.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aol/shared": "workspace:*",
    "@aol/engine": "workspace:*",
    "@aol/game": "workspace:*",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^6.0.1"
  }
}
