# ---------------------------------------------------------------------------
# Age of Legends — Environment Template
# Copy to .env and adjust values for your local environment.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Gateway / API ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# --- Realtime (WebSocket) --------------------------------------------------
WS_HOST=0.0.0.0
WS_PORT=4001
# Simulation tick rate in Hz (authoritative server)
SIM_TICK_RATE=20
# Snapshot broadcast rate in Hz
NET_SNAPSHOT_RATE=10

# --- Client ----------------------------------------------------------------
CLIENT_PORT=5173
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4001

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=age_of_legends
POSTGRES_USER=aol
POSTGRES_PASSWORD=change_me_in_local
DATABASE_URL=postgresql://aol:change_me_in_local@localhost:5432/age_of_legends

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Authentication --------------------------------------------------------
# Generate strong random values for real environments.
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- World / Shards --------------------------------------------------------
WORLD_SEED=age-of-legends-0001
SHARD_ID=shard-01
MAX_PLAYERS_PER_SHARD=2000

# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9464
