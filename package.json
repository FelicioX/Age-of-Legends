{
  "name": "age-of-legends",
  "version": "0.1.0",
  "private": true,
  "description": "A next-generation MMORPG featuring persistent worlds, kingdom building, exploration, strategic combat, and large-scale multiplayer.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "shared",
    "engine",
    "game",
    "server",
    "client"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules/.cache .turbo",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.14.0",
    "vitest": "^4.1.10"
  }
}
