{
  "name": "@aol/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative server for Age of Legends: gateway, API and world simulation.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aol/shared": "workspace:*",
    "@aol/engine": "workspace:*",
    "@aol/game": "workspace:*",
    "fastify": "^5.12.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
